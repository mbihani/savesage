{
  "type": "object",
  "additionalProperties": false,
  "required": ["statementMeta", "statementLevelSummary", "cards", "transactions", "rewards"],
  "properties": {
    "statementMeta": {
      "type": "object", "additionalProperties": false,
      "required": ["issuerName", "statementDate", "dueDate", "statementPeriodStart", "statementPeriodEnd", "rawStatementId"],
      "properties": {
        "issuerName": {"type": ["string", "null"]},
        "statementDate": {"type": ["string", "null"]},
        "dueDate": {"type": ["string", "null"]},
        "statementPeriodStart": {"type": ["string", "null"]},
        "statementPeriodEnd": {"type": ["string", "null"]},
        "rawStatementId": {"type": ["string", "null"]}
      }
    },
    "statementLevelSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["totalAmountDue", "totalMinimumAmountDue", "totalCreditLimit", "availableCreditLimit"],
      "properties": {
        "totalAmountDue": {"type": ["number", "null"]},
        "totalMinimumAmountDue": {"type": ["number", "null"]},
        "totalCreditLimit": {"type": ["number", "null"]},
        "availableCreditLimit": {"type": ["number", "null"]}
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["cardMeta", "bigPicture"],
        "properties": {
          "cardMeta": {
            "type": "object", "additionalProperties": false,
            "required": ["cardDisplayName", "productFamily", "lastFourDigit", "network", "isPrimaryCard"],
            "properties": {
              "cardDisplayName": {"type": ["string", "null"]},
              "productFamily": {"type": ["string", "null"]},
              "lastFourDigit": {"type": ["string", "null"]},
              "network": {"type": ["string", "null"]},
              "isPrimaryCard": {"type": ["boolean", "null"]}
            }
          },
          "bigPicture": {
            "type": "object", "additionalProperties": false,
            "required": ["cardCreditLimit", "cardAvailableCreditLimit"],
            "properties": {
              "cardCreditLimit": {"type": ["number", "null"]},
              "cardAvailableCreditLimit": {"type": ["number", "null"]}
            }
          }
        }
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["date", "description", "amount", "direction", "txnType", "rewardPointsOnThisTransaction", "currency"],
        "properties": {
          "date": {"type": ["string", "null"]},
          "description": {"type": ["string", "null"]},
          "amount": {"type": ["number", "null"]},
          "direction": {"type": ["string", "null"], "enum": ["DEBIT", "CREDIT", null]},
          "txnType": {"type": ["string", "null"], "enum": ["PURCHASE", "PAYMENT", "REFUND", "REVERSAL", "CASHBACK", "FEE", "TAX", "INTEREST", "EMI", "CASH_ADVANCE", "UPI", null]},
          "rewardPointsOnThisTransaction": {"type": ["number", "null"]},
          "currency": {"type": ["string", "null"]}
        }
      }
    },
    "rewards": {
      "type": "object", "additionalProperties": false,
      "required": ["programType", "openingPoints", "pointsEarnedThisCycle", "pointsRedeemedThisCycle", "closingPoints", "pointsExpiringNext30Days", "pointsExpiringNext60Days", "bonusPointsThisCycle"],
      "properties": {
        "programType": {"type": ["string", "null"]},
        "openingPoints": {"type": ["number", "null"]},
        "pointsEarnedThisCycle": {"type": ["number", "null"]},
        "pointsRedeemedThisCycle": {"type": ["number", "null"]},
        "closingPoints": {"type": ["number", "null"]},
        "pointsExpiringNext30Days": {"type": ["number", "null"]},
        "pointsExpiringNext60Days": {"type": ["number", "null"]},
        "bonusPointsThisCycle": {"type": ["number", "null"]}
      }
    }
  }
}
